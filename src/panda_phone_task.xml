
<mujoco model="panda_phone_task">

    <include file="panda.xml"/>

    <option timestep="0.002" gravity="0 0 -9.81"/>

    <visual>
        <headlight diffuse="0.8 0.8 0.8"
                   ambient="0.3 0.3 0.3"
                   specular="0.1 0.1 0.1"/>
    </visual>

    <!-- Floor -->
    <worldbody>

        <geom name="floor"
              type="plane"
              size="2 2 0.01"
              pos="0 0 0"
              rgba="0.75 0.75 0.75 1"/>

        <!-- Table -->
        <body name="table"
              pos="0.40 0 0.30">

            <geom name="tabletop"
                  type="box"
                  size="0.30 0.30 0.025"
                  pos="0 0 0"
                  rgba="0.45 0.25 0.12 1"/>

            <geom name="leg1"
                  type="box"
                  size="0.025 0.025 0.15"
                  pos="-0.25 -0.25 -0.175"/>

            <geom name="leg2"
                  type="box"
                  size="0.025 0.025 0.15"
                  pos="0.25 -0.25 -0.175"/>

            <geom name="leg3"
                  type="box"
                  size="0.025 0.025 0.15"
                  pos="-0.25 0.25 -0.175"/>

            <geom name="leg4"
                  type="box"
                  size="0.025 0.025 0.15"
                  pos="0.25 0.25 -0.175"/>

        </body>

        <!-- Cube -->
        <body name="cube"
              pos="0.40 0 0.355">

            <freejoint name="free"/>

            <geom name="cube_geom"
                  type="box"
                  size="0.020 0.020 0.020"
                  mass="0.05"
                  rgba="0.9 0.15 0.05 1"/>

        </body>

        <!-- Target box -->
        <body name="drop_box"
              pos="0.55 0.10 0.36">

            <!-- Bottom -->
            <geom name="box_bottom"
                  type="box"
                  size="0.045 0.045 0.005"
                  pos="0 0 -0.025"
                  rgba="0.1 0.7 0.2 1"/>

            <!-- Left wall -->
            <geom name="box_left"
                  type="box"
                  size="0.005 0.040 0.040"
                  pos="-0.045 0 0.040"
                  rgba="0.1 0.7 0.2 1"/>

            <!-- Right wall -->
            <geom name="box_right"
                  type="box"
                  size="0.005 0.040 0.040"
                  pos="0.045 0 0.040"
                  rgba="0.1 0.7 0.2 1"/>

            <!-- Back wall -->
            <geom name="box_back"
                  type="box"
                  size="0.040 0.005 0.040"
                  pos="0 -0.045 0.040"
                  rgba="0.1 0.7 0.2 1"/>

            <!-- Front wall -->
            <geom name="box_front"
                  type="box"
                  size="0.040 0.005 0.040"
                  pos="0 0.045 0.040"
                  rgba="0.1 0.7 0.2 1"/>

        </body>

        <!-- Cameras -->
        <camera name="task_camera"
                pos="0.95 -1.10 0.85"
                xyaxes="0.707 0.707 0 -0.30 0.30 0.905"
                fovy="45"/>

        <camera name="top_task_camera"
                pos="0.55 -0.65 1.20"
                xyaxes="1 0 0 0 0.85 0.53"
                fovy="50"/>

    </worldbody>

</mujoco>
